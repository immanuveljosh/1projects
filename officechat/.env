# OfficeChat Environment Configuration Example
# Copy to .env for local development

# Application Server
PORT=8080
ENV=development
APP_NAME=OfficeChat
APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=officechat
DB_PASSWORD=officechat_secret
DB_NAME=officechat_db
DB_SSLMODE=disable
DATABASE_URL=postgres://officechat:officechat_secret@localhost:5433/officechat_db?sslmode=disable

# Redis (Presence & Pub/Sub Fanout)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=officechat-files
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# JWT Authentication
JWT_ACCESS_SECRET=officechat_access_token_secret_32bytes_min_length!
JWT_REFRESH_SECRET=officechat_refresh_token_secret_32bytes_min_length!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Sharing & Uploads
MAX_FILE_SIZE_MB=25
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_MOCK=true

# Frontend Configuration (for web app)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
