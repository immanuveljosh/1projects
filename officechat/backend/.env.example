# OfficeChat Backend Local Development Configuration Example
# Copy this file to .env:
#   cp .env.example .env

PORT=8080
ENV=development
APP_NAME=OfficeChat
APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=officechat
DB_PASSWORD=officechat_secret
DB_NAME=officechat_db
DB_SSLMODE=disable
DATABASE_URL=postgres://officechat:officechat_secret@localhost:5432/officechat_db?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=officechat-files
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

JWT_ACCESS_SECRET=officechat_access_token_secret_32bytes_min_length!
JWT_REFRESH_SECRET=officechat_refresh_token_secret_32bytes_min_length!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

MAX_FILE_SIZE_MB=25
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_MOCK=true
