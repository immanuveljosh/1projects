# ==============================================================================
# OfficeChat Production Environment Configuration
# Copy this file to .env on the production host:
#   cp deploy/.env.example deploy/.env
# Generate high-entropy secrets (32+ bytes) for all passwords & keys:
#   openssl rand -hex 32
# ==============================================================================

# Public Hostnames & TLS Configuration
DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=admin@example.com
TLS_MODE=admin@example.com

# Admin Console Security (Restricted CIDR list or specific IPs)
ADMIN_ALLOWED_IPS=0.0.0.0/0

# PostgreSQL 16 Credentials (SCRAM-SHA-256)
DB_USER=officechat
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_HEX_32
DB_NAME=officechat_prod

# Redis 7 Password (requirepass)
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_HEX_32

# MinIO S3 Object Storage Credentials
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET_KEY
MINIO_BUCKET=officechat-production-files
MINIO_REGION=us-east-1

# JWT Signing Keys (Minimum 32 bytes / 256 bits hex)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_JWT_ACCESS_SECRET_HEX_32
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_JWT_REFRESH_SECRET_HEX_32

# Application Settings
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_MOCK=false
